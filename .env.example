# Copy to .env.local for local development.

# Local: the Postgres container from docker-compose.yml.
# Vercel: set automatically by the Neon integration (pooled connection).
DATABASE_URL=postgresql://learntube:learntube@localhost:5433/learntube

# Vercel only: direct (non-pooled) connection, used by `prisma migrate deploy`.
# Set automatically by the Neon integration.
# DATABASE_URL_UNPOOLED=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Photo uploads for makes. Vercel → Storage → Create → Blob
BLOB_READ_WRITE_TOKEN=

# Comma-separated emails that become admins (content editor and reports queue at
# /admin) the next time they sign in.
ADMIN_EMAILS=

# Anthropic API key for Claude
ANTHROPIC_API_KEY=
