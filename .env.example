# Copy to .env.local for local development.

# Local: the Postgres container from docker-compose.yml.
# Vercel: set automatically by the Neon integration (pooled connection).
DATABASE_URL=postgresql://learntube:learntube@localhost:5433/learntube

# Vercel only: direct (non-pooled) connection, used by `prisma migrate deploy`.
# Set automatically by the Neon integration. Leave unset locally.
# DATABASE_URL_UNPOOLED=

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Generate with: openssl rand -base64 32 (use a different value in production)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
