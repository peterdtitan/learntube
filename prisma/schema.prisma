// Prisma schema for NextAuth + app models
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  pathways      Pathway[]
  videoProgress VideoProgress[]
  notes         Note[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Pathway {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  units       Unit[]
  videos      Video[]
}

model Unit {
  id          String   @id @default(cuid())
  title       String
  description String?
  order       Int      @default(0)
  pathwayId   String
  pathway     Pathway  @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  videos      Video[]
}

model Video {
  id           String   @id @default(cuid())
  title        String
  description  String?
  url          String   // full YouTube URL or video ID
  duration     Int      // seconds
  order        Int      @default(0)
  captionsLang String?  // e.g. "en", passed to the YouTube player for CC
  transcript   String?  // plain-text transcript shown under the player
  pathway      Pathway? @relation(fields: [pathwayId], references: [id])
  pathwayId    String?
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId       String?
  progress     VideoProgress[]
  notes        Note[]
}

model VideoProgress {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  stoppedAt Int      // seconds position
  completed Boolean  @default(false)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@unique([userId, videoId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  content   String
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  @@unique([userId, videoId])
}
