// Prisma schema for NextAuth + app models
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String          @id @default(cuid())
  name              String?
  email             String?         @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  pathways          Pathway[]
  videoProgress     VideoProgress[]
  notes             Note[]
  makes             Make[]
  kudos             Kudos[]
  xpEvents          XpEvent[]
  comments          MakeComment[]
  following         Follow[]        @relation("follower")
  followers         Follow[]        @relation("following")
  milestones        Milestone[]
  cheers            Cheer[]
  showOnLeaderboard Boolean         @default(true)
  weeklyGoal        Int             @default(3) // practice days per week, 2-5
  timeZone          String          @default("UTC") // IANA name; decides where a practice day and week begin
  role              Role            @default(LEARNER)
  displayName       String? // shown publicly instead of the Google account name
  reports           Report[]
  notifications     Notification[]  @relation("recipient")
  notificationsSent Notification[]  @relation("actor")
  quizAttempts      QuizAttempt[]
  extraQuizTime     Boolean         @default(false) // accessibility: 1.5x time on timed quizzes
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum Role {
  LEARNER
  ADMIN
}

enum SkillTier {
  HAND
  SCREEN
}

model Skill {
  id       String    @id // stable slug, e.g. "cooking"
  name     String
  tier     SkillTier
  color    String // hex, shared by web and app
  order    Int       @default(0)
  pathways Pathway[]
  xpEvents XpEvent[]
}

model Pathway {
  id          String      @id @default(cuid())
  title       String
  description String?
  makeTitle   String? // what the learner has made by the end
  skillId     String?
  skill       Skill?      @relation(fields: [skillId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?       @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  units       Unit[]
  videos      Video[]
  makes       Make[]
  xpEvents    XpEvent[]
  milestones  Milestone[]
}

// Shown to learners as a module ("Week 1"). Lessons belong to it, plus an optional
// checkpoint quiz halfway through and a game at the end.
model Unit {
  id          String  @id @default(cuid())
  title       String
  description String?
  order       Int     @default(0)
  pathwayId   String
  pathway     Pathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  videos      Video[]
  quizzes     Quiz[]
}

model Video {
  id              String          @id @default(cuid())
  title           String
  description     String?
  url             String // full YouTube URL or video ID
  duration        Int // seconds
  order           Int             @default(0)
  captionsLang    String? // e.g. "en", passed to the YouTube player for CC
  transcript      String? // plain-text transcript shown under the player
  tryTask         String? // the hands-on step after watching, e.g. "Cast on 20 stitches"
  starterCode     String? // HTML/CSS/JS the code sandbox opens with
  practiceMinutes Int? // time to do the Try step; null means "estimate from the video"
  quizzes         Quiz[]
  pathway         Pathway?        @relation(fields: [pathwayId], references: [id])
  pathwayId       String?
  unit            Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  unitId          String?
  progress        VideoProgress[]
  notes           Note[]
  makes           Make[]
}

model VideoProgress {
  id        String    @id @default(cuid())
  userId    String
  videoId   String
  watchedAt DateTime  @default(now())
  stoppedAt Int // seconds position
  completed Boolean   @default(false) // watched to the end
  triedAt   DateTime? // when the learner marked the Try step done

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  videoId   String
  content   String
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  video Video @relation(fields: [videoId], references: [id], onDelete: Cascade)

  @@unique([userId, videoId])
}

model Make {
  id        String    @id @default(cuid())
  userId    String
  videoId   String? // the lesson this came from
  pathwayId String? // set for a pathway's final project
  title     String
  note      String?
  imageUrl  String?
  createdAt DateTime  @default(now())
  // Set when reports cross the threshold or an admin hides it; only the author and admins see it.
  hiddenAt  DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  video         Video?         @relation(fields: [videoId], references: [id], onDelete: SetNull)
  pathway       Pathway?       @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  kudos         Kudos[]
  comments      MakeComment[]
  reports       Report[]
  notifications Notification[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model Kudos {
  userId    String
  makeId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  make Make @relation(fields: [makeId], references: [id], onDelete: Cascade)

  @@id([userId, makeId])
}

enum XpKind {
  WATCH
  TRY
  LOG
  QUIZ
}

// Append-only XP ledger. sourceKey makes each award happen once, e.g. "try:<videoId>".
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  kind      XpKind
  amount    Int
  sourceKey String
  // Where the XP was earned, so leaderboards can rank per pathway or skill.
  pathwayId String?
  skillId   String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway Pathway? @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  skill   Skill?   @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@unique([userId, sourceKey])
  @@index([userId, createdAt])
  @@index([pathwayId, createdAt])
  @@index([skillId, createdAt])
  @@index([createdAt])
}

// Comments are picked from a fixed list of phrases (src/lib/comments.js), so there's no free text to moderate.
model MakeComment {
  id        String   @id @default(cuid())
  makeId    String
  userId    String
  preset    String
  createdAt DateTime @default(now())

  make Make @relation(fields: [makeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([makeId, userId, preset])
  @@index([makeId, createdAt])
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

enum MilestoneKind {
  XP
  STREAK
  FIRST_MAKE
  PATHWAY_DONE
}

// Recorded once per learner per key, e.g. "xp:500", "streak:4", "pathway:<id>".
model Milestone {
  id        String        @id @default(cuid())
  userId    String
  kind      MilestoneKind
  key       String
  value     Int?
  pathwayId String?
  createdAt DateTime      @default(now())

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathway       Pathway?       @relation(fields: [pathwayId], references: [id], onDelete: SetNull)
  cheers        Cheer[]
  notifications Notification[]

  @@unique([userId, key])
  @@index([userId, createdAt])
}

model Cheer {
  userId      String
  milestoneId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@id([userId, milestoneId])
}

// One report per learner per make. reason is a preset id from src/lib/moderation.js.
model Report {
  id         String    @id @default(cuid())
  makeId     String
  reporterId String
  reason     String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime? // set when an admin keeps, hides or deletes the make

  make     Make @relation(fields: [makeId], references: [id], onDelete: Cascade)
  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([makeId, reporterId])
  @@index([resolvedAt, createdAt])
}

enum NotificationKind {
  KUDOS
  COMMENT
  FOLLOW
  CHEER
}

// key makes each notification happen once, e.g. "kudos:<makeId>:<actorId>", so taking
// kudos back and giving it again doesn't notify twice.
model Notification {
  id          String           @id @default(cuid())
  userId      String // who is told
  actorId     String // who did it
  kind        NotificationKind
  key         String
  makeId      String?
  milestoneId String?
  preset      String? // the comment phrase, for COMMENT
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  user      User       @relation("recipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User       @relation("actor", fields: [actorId], references: [id], onDelete: Cascade)
  make      Make?      @relation(fields: [makeId], references: [id], onDelete: Cascade)
  milestone Milestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// Fixed-window counters for the write APIs, keyed like "comment:<userId>".
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int      @default(0)

  @@index([windowStart])
}

enum QuizKind {
  LESSON_CHECK // a few questions after one lesson
  CHECKPOINT // timed, halfway through a module, with integrity tracking
  MODULE_GAME // game rounds at the end of a module
}

enum QuestionType {
  SINGLE
  MULTI
  TRUE_FALSE
  ORDER
  MATCH
  TEXT
  NUMBER
}

model Quiz {
  id           String   @id @default(cuid())
  kind         QuizKind
  title        String?
  videoId      String? // LESSON_CHECK
  unitId       String? // CHECKPOINT and MODULE_GAME
  afterVideoId String? // where a checkpoint sits; null puts it after the middle lesson
  published    Boolean  @default(false)
  timeLimitSec Int? // CHECKPOINT only
  passPercent  Int      @default(70)
  // Integrity penalties, in percentage points off the score (CHECKPOINT only).
  leavePenalty Int      @default(3) // each time the learner leaves the quiz
  awayPenalty  Int      @default(1) // each 10 seconds away
  copyPenalty  Int      @default(2) // each copy or paste
  maxPenalty   Int      @default(50)
  timePenalty  Int      @default(1) // extra seconds taken off the clock per second away
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  video     Video?        @relation(fields: [videoId], references: [id], onDelete: Cascade)
  unit      Unit?         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  questions Question[]
  attempts  QuizAttempt[]

  @@unique([videoId, kind])
  @@unique([unitId, kind])
}

// data holds the options and answer for the type; see src/lib/quizGrade.js.
model Question {
  id          String       @id @default(cuid())
  quizId      String
  order       Int          @default(0)
  type        QuestionType
  prompt      String
  data        Json
  explanation String?
  aiDrafted   Boolean      @default(false)

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, order])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  quizId      String
  userId      String
  startedAt   DateTime  @default(now())
  deadlineAt  DateTime? // timed quizzes; already includes any extra time
  submittedAt DateTime?
  answers     Json?
  score       Float? // before penalties, 0-100
  penalty     Float     @default(0) // percentage points taken off
  finalScore  Float? // after penalties, 0-100
  passed      Boolean?
  leaveCount  Int       @default(0)
  awaySeconds Int       @default(0)
  copyCount   Int       @default(0)
  pasteCount  Int       @default(0)
  events      Json? // integrity log: leaves, copies (with the text), pastes
  results     Json? // per-question right/wrong, shown after submitting

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([quizId, userId, startedAt])
  @@index([userId, submittedAt])
}
